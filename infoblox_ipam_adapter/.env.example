# Copy to .env and edit
infoblox_url=https://infoblox.example/wapi/v2.12
infoblox_user=infoblox_user
infoblox_pass=infoblox_pass
infoblox_verify=true
# Optional client certs
#infoblox_client_cert=/path/to/cert.pem
#infoblox_client_key=/path/to/key.pem

# Adapter API token (FAST should call with Bearer token)
api_token=replace-with-secure-token

request_timeout=10
